#!/bin/sh
set -eu

if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
  echo "Aura wallpaper requires a valid XDG_RUNTIME_DIR." >&2
  exit 1
fi
if ! command -v swaybg >/dev/null 2>&1; then
  echo "Aura wallpaper requires swaybg." >&2
  exit 1
fi

PID_FILE="$XDG_RUNTIME_DIR/aura-wallpaper.pid"
if [ -L "$PID_FILE" ]; then
  echo "Refusing to use a symlink wallpaper PID file." >&2
  exit 1
fi
if [ -f "$PID_FILE" ]; then
  old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  case "$old_pid" in
    ""|*[!0-9]*) ;;
    *)
      if [ -r "/proc/$old_pid/comm" ]; then
        IFS= read -r old_comm < "/proc/$old_pid/comm" || true
        if [ "$old_comm" = "swaybg" ] && kill -0 "$old_pid" 2>/dev/null; then
          kill -TERM "$old_pid" 2>/dev/null || true
        fi
      fi
      ;;
  esac
fi

COLOR="#101827"
CONFIG_FILE="$HOME/.config/aura/desktop.conf"
if [ -f "$CONFIG_FILE" ]; then
  while IFS='=' read -r key value; do
    if [ "$key" = "background" ]; then
      COLOR="$value"
    fi
  done < "$CONFIG_FILE"
fi

case "$COLOR" in
  \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
  *) COLOR="#101827" ;;
esac

umask 077
swaybg --color "$COLOR" >/dev/null 2>&1 &
wallpaper_pid=$!
temporary_pid_file="$PID_FILE.tmp.$$"
printf '%s\n' "$wallpaper_pid" > "$temporary_pid_file"
mv -f "$temporary_pid_file" "$PID_FILE"
