#!/bin/sh
# Read-only Aura OS diagnostic bundle generator.
set -u
umask 077

VERSION=1
INCLUDE_JOURNAL=0
OUTPUT=

usage() {
    cat <<'EOF'
Usage: aura-diagnose [--output FILE.tar.gz] [--include-journal]

Create a private, read-only diagnostic archive. No system settings or disks
are modified. Journal collection is opt-in because logs may contain private
information. Review the archive before sharing it.
EOF
}

error() {
    printf 'aura-diagnose: error: %s\n' "$*" >&2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --output)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                error "--output requires a file path"
                exit 2
            fi
            OUTPUT=$2
            shift 2
            ;;
        --include-journal)
            INCLUDE_JOURNAL=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            error "unknown option: $1"
            usage >&2
            exit 2
            ;;
    esac
done

if [ -z "$OUTPUT" ]; then
    timestamp=$(date -u '+%Y%m%dT%H%M%SZ' 2>/dev/null || printf 'undated')
    OUTPUT="/var/tmp/aura-diagnostics-$timestamp.tar.gz"
fi

case "$OUTPUT" in
    /*) ;;
    *) OUTPUT="$PWD/$OUTPUT" ;;
esac

case "$OUTPUT" in
    */*)
        OUTPUT_DIR=${OUTPUT%/*}
        OUTPUT_NAME=${OUTPUT##*/}
        [ -n "$OUTPUT_DIR" ] || OUTPUT_DIR=/
        ;;
    *)
        OUTPUT_DIR=.
        OUTPUT_NAME=$OUTPUT
        ;;
esac

if [ -z "$OUTPUT_NAME" ] || [ "$OUTPUT_NAME" = "." ] || [ "$OUTPUT_NAME" = ".." ]; then
    error "output path must name an archive file"
    exit 2
fi
if [ ! -d "$OUTPUT_DIR" ]; then
    error "output directory does not exist: $OUTPUT_DIR"
    exit 1
fi
if [ -e "$OUTPUT" ]; then
    error "refusing to overwrite existing file: $OUTPUT"
    exit 1
fi

TMP_BASE=${TMPDIR:-/tmp}
WORK_DIR=$(mktemp -d "$TMP_BASE/aura-diagnose.XXXXXX") || {
    error "could not create a private temporary directory"
    exit 1
}
TEMP_ARCHIVE=
cleanup() {
    [ -z "$WORK_DIR" ] || rm -rf -- "$WORK_DIR"
    [ -z "$TEMP_ARCHIVE" ] || rm -f -- "$TEMP_ARCHIVE"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

CAPTURE_INDEX="$WORK_DIR/capture-index.txt"
: > "$CAPTURE_INDEX"

capture() {
    section=$1
    shift
    output_file="$WORK_DIR/$section.txt"
    command_name=$1
    {
        printf 'section=%s\n' "$section"
        printf 'command='
        printf '%s ' "$@"
        printf '\n'
    } > "$output_file"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'status=unavailable\ncommand_not_found=%s\n' "$command_name" >> "$output_file"
        printf '%s\tunavailable\n' "$section" >> "$CAPTURE_INDEX"
        return 0
    fi

    "$@" >> "$output_file" 2>&1
    result=$?
    printf '\nexit_status=%s\n' "$result" >> "$output_file"
    if [ "$result" -eq 0 ]; then
        printf '%s\tok\n' "$section" >> "$CAPTURE_INDEX"
    else
        printf '%s\texited-%s\n' "$section" "$result" >> "$CAPTURE_INDEX"
    fi
    return 0
}

capture_file() {
    section=$1
    source_file=$2
    output_file="$WORK_DIR/$section.txt"
    {
        printf 'section=%s\nfile=%s\n' "$section" "$source_file"
        if [ -r "$source_file" ]; then
            cat "$source_file"
            printf '\nstatus=read\n'
            printf '%s\tread\n' "$section" >> "$CAPTURE_INDEX"
        else
            printf 'status=not-present-or-not-readable\n'
            printf '%s\tunavailable\n' "$section" >> "$CAPTURE_INDEX"
        fi
    } > "$output_file" 2>&1
    return 0
}

capture system-uname uname -a
capture system-hostname hostname
capture system-uptime uptime
capture system-memory cat /proc/meminfo
capture system-os-release cat /etc/os-release
capture system-aura-release cat /etc/aura-release

capture services-system-state systemctl is-system-running
capture services-failed systemctl --failed --no-legend --plain
capture services-network-time systemctl is-active systemd-networkd.service systemd-resolved.service systemd-timesyncd.service
capture services-boot-time systemd-analyze time

capture storage-block-devices lsblk --json --output NAME,PATH,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS,RO
capture storage-mounts findmnt --json --output TARGET,SOURCE,FSTYPE,UUID
capture storage-space df -hT
capture_file storage-install-manifest /var/lib/aura/install-manifest

capture network-addresses ip -brief address
capture network-routes ip route
capture network-resolver resolvectl status
capture network-links networkctl list

if [ "$INCLUDE_JOURNAL" -eq 1 ]; then
    capture journal-current-boot journalctl --boot --priority=warning --no-pager --lines=200
fi

CREATED_UTC=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown')
{
    printf 'Aura OS diagnostic bundle\n'
    printf 'Format version: %s\n' "$VERSION"
    printf 'Created UTC: %s\n' "$CREATED_UTC"
    printf 'Diagnostics mode: read-only\n'
    printf 'Journal included: %s\n' "$INCLUDE_JOURNAL"
    printf '\n'
    printf '%s\n' \
        'No repair, package update, service restart, partition write, or filesystem modification was performed.' \
        '' \
        'Privacy notice:' \
        '- The report may contain hostname, IP addresses, interface names, disk models and filesystem UUIDs, mount points, and system service state.' \
        '- Journal output is excluded unless --include-journal is supplied. Journal entries may contain usernames, addresses, application details, or other private information.' \
        '- Review all files in this archive before publishing or sending it to another person.' \
        '- Password databases, shell history, environment variables, and user document contents are not collected.' \
        ''
    printf 'Captured sections (section<TAB>status):\n'
    cat "$CAPTURE_INDEX"
} > "$WORK_DIR/README.txt"

TEMP_ARCHIVE=$(mktemp "$OUTPUT_DIR/.$OUTPUT_NAME.tmp.XXXXXX") || {
    error "could not create a temporary archive in $OUTPUT_DIR"
    exit 1
}
if ! tar -czf "$TEMP_ARCHIVE" -C "$WORK_DIR" .; then
    error "could not create the diagnostic archive"
    exit 1
fi

# -n prevents replacing an archive created concurrently after the initial check.
mv -n -- "$TEMP_ARCHIVE" "$OUTPUT"
if [ -e "$TEMP_ARCHIVE" ]; then
    error "output file appeared while the report was being created: $OUTPUT"
    exit 1
fi
TEMP_ARCHIVE=

printf 'Aura OS diagnostics saved: %s\n' "$OUTPUT"
printf 'Review the archive before sharing it.\n'
exit 0
