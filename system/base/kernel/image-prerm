#!/bin/sh
set -eu
ROOT="${AURA_ROOT:-}"
path() { printf '%s%s' "$ROOT" "$1"; }
case "${1:-}" in
  remove|purge)
    package="${DPKG_MAINTSCRIPT_PACKAGE:-}"
    version="${package#aura-kernel-image-}"
    for state in "$(path /var/lib/aura-kernel/pending)" "$(path /var/lib/aura-kernel/known-good)"; do
      if [ -s "$state" ] && [ "$(sed -n '1p' "$state")" = "$version" ] \
         && [ "${AURA_KERNEL_ALLOW_UNSAFE_REMOVE:-0}" != 1 ]; then
        echo "Refusing to remove Aura kernel $version: it is pending or marked known-good." >&2
        echo "Boot and confirm another kernel first, or set AURA_KERNEL_ALLOW_UNSAFE_REMOVE=1 for an intentional recovery operation." >&2
        exit 1
      fi
    done
    remaining=0
    for image in "$(path /boot)"/vmlinuz-aura-*; do
      [ -s "$image" ] || continue
      image_name="${image##*/}"
      image_version="${image_name#vmlinuz-aura-}"
      [ "$image_version" = "$version" ] && continue
      remaining=1
      break
    done
    if [ "$remaining" -eq 0 ] && [ "${AURA_KERNEL_ALLOW_UNSAFE_REMOVE:-0}" != 1 ]; then
      echo "Refusing to remove the last installed Aura kernel image." >&2
      exit 1
    fi
    ;;
esac
exit 0
