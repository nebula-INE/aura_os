#!/bin/sh
set -eu
ROOT="${AURA_ROOT:-}"
path() { printf '%s%s' "$ROOT" "$1"; }
FSTAB="$(path /etc/fstab)"
ARCH_FILE="$(path /etc/aura-kernel/architecture)"
CMDLINE_FILE="$(path /etc/aura-kernel/cmdline)"
BOOT_DIR="$(path /boot)"
GRUB_DIR="$(path /boot/grub)"
OUTPUT="$(path /boot/grub/grub.cfg)"
[ -s "$FSTAB" ] || { echo "Aura kernel: /etc/fstab is missing." >&2; exit 1; }
[ -s "$ARCH_FILE" ] || { echo "Aura kernel: target architecture is missing." >&2; exit 1; }
[ -s "$CMDLINE_FILE" ] || { echo "Aura kernel: kernel command line is missing." >&2; exit 1; }
ARCH="$(sed -n '1p' "$ARCH_FILE")"
case "$ARCH" in x86_64|aarch64|riscv64) ;; *) echo "Aura kernel: invalid architecture: $ARCH" >&2; exit 1 ;; esac
ROOT_SOURCE="$(awk '$2 == "/" { print $1; exit }' "$FSTAB")"
case "$ROOT_SOURCE" in UUID=*) ROOT_UUID="${ROOT_SOURCE#UUID=}" ;; *) echo "Aura kernel: root filesystem must use a UUID in /etc/fstab." >&2; exit 1 ;; esac
case "$ROOT_UUID" in *[!0123456789abcdefABCDEF-]*|'') echo "Aura kernel: invalid root UUID." >&2; exit 1 ;; esac
CMDLINE="$(sed -n '1p' "$CMDLINE_FILE")"
[ -n "$CMDLINE" ] || { echo "Aura kernel: kernel command line is empty." >&2; exit 1; }
if ! printf '%s\n' "$CMDLINE" | awk 'length($0) > 512 || $0 !~ /^[A-Za-z0-9_.=,:+ -]*$/ { exit 1 }'; then
    echo "Aura kernel: unsafe character or excessive length in /etc/aura-kernel/cmdline." >&2
    exit 1
fi
mkdir -p "$GRUB_DIR"
TMP_OUTPUT="$OUTPUT.tmp.$$"
trap 'rm -f "$TMP_OUTPUT"' EXIT HUP INT TERM
cat > "$TMP_OUTPUT" <<'GRUB'
# Generated by Aura OS aura-kernel. Local edits will be overwritten.
if [ -s $prefix/grubenv ]; then
    load_env
fi
if [ -n "$next_entry" ]; then
    set default="$next_entry"
    set next_entry=
    save_env next_entry
else
    set default="${saved_entry}"
fi
if [ -z "$default" ]; then
    set default=0
fi
set timeout=5
insmod part_gpt
insmod ext2
GRUB
printf 'search --no-floppy --fs-uuid --set=root %s\n\n' "$ROOT_UUID" >> "$TMP_OUTPUT"
found=0
for kernel in "$BOOT_DIR"/vmlinuz-aura-*; do
    [ -s "$kernel" ] || continue
    kernel_name="${kernel##*/}"
    version="${kernel_name#vmlinuz-aura-}"
    case "$version" in
      ''|*[!A-Za-z0-9.+~-]*)
        echo "Aura kernel: unsafe versioned kernel filename: $version" >&2
        exit 1
        ;;
    esac
    config="$(path "/usr/share/aura-kernel/$version.conf")"
    [ -s "$config" ] || continue
    if [ "$(wc -l < "$config")" -ne 3 ] ||
       [ "$(grep -c '^AURA_KERNEL_ARCH=' "$config")" -ne 1 ] ||
       [ "$(grep -c '^AURA_INITRAMFS_MODE=' "$config")" -ne 1 ] ||
       [ "$(grep -c '^AURA_KERNEL_MODULES=' "$config")" -ne 1 ] ||
       ! grep -Eq '^AURA_KERNEL_ARCH=(x86_64|aarch64|riscv64)$' "$config" ||
       ! grep -Eq '^AURA_INITRAMFS_MODE=(external|embedded)$' "$config" ||
       ! grep -Eq '^AURA_KERNEL_MODULES=(0|1)$' "$config"; then
        echo "Aura kernel: invalid version metadata for $version." >&2
        exit 1
    fi
    AURA_KERNEL_ARCH="$(sed -n 's/^AURA_KERNEL_ARCH=//p' "$config")"
    AURA_INITRAMFS_MODE="$(sed -n 's/^AURA_INITRAMFS_MODE=//p' "$config")"
    AURA_KERNEL_MODULES="$(sed -n 's/^AURA_KERNEL_MODULES=//p' "$config")"
    [ "$AURA_KERNEL_ARCH" = "$ARCH" ] || continue
    case "$AURA_INITRAMFS_MODE" in
      external)
        initrd="$(path "/boot/aura-initramfs-$version.cpio.gz")"
        [ -s "$initrd" ] || { echo "Aura kernel: matching initramfs is missing for $version." >&2; exit 1; }
        initrd_line="    initrd /boot/aura-initramfs-$version.cpio.gz"
        ;;
      embedded) initrd_line="" ;;
      *) echo "Aura kernel: invalid initramfs mode for $version." >&2; exit 1 ;;
    esac
    cat >> "$TMP_OUTPUT" <<ENTRY
menuentry 'Aura OS ($version)' --id 'aura-$version' {
    search --no-floppy --fs-uuid --set=root $ROOT_UUID
    linux /boot/vmlinuz-aura-$version root=UUID=$ROOT_UUID $CMDLINE
$initrd_line
}
menuentry 'Aura OS ($version, Recovery Mode)' --id 'aura-$version-recovery' {
    search --no-floppy --fs-uuid --set=root $ROOT_UUID
    linux /boot/vmlinuz-aura-$version root=UUID=$ROOT_UUID $CMDLINE systemd.unit=aura-recovery.target
$initrd_line
}
ENTRY
    found=$((found + 1))
done
[ "$found" -gt 0 ] || { echo "Aura kernel: no installed versioned kernel images were found." >&2; exit 1; }
chmod 0644 "$TMP_OUTPUT"
mv -f "$TMP_OUTPUT" "$OUTPUT"
trap - EXIT HUP INT TERM
printf 'Generated GRUB menu with %s Aura kernel version(s).\n' "$found"
