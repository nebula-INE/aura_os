# Aura OS x86-64 QEMU bring-up fragment
# Merged on top of the upstream x86_64_defconfig.

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# QEMU virtio devices (built in for the first boot path).
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y


# Persistent Debian rootfs support (built into the kernel for early boot).
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP2_FS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FANOTIFY=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Serial console for deterministic CI diagnostics.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK_TIME=y

# Keep the initial image broadly useful while avoiding debug overhead.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
